{
  "routes": [
    {
      "route": "/about-us",
      "rewrite": "/about-us.html",
      "headers": {
        "cache-control": "public, max-age=30, must-revalidate"
      }
    },
    {
      "route": "/about",
      "rewrite": "/about.html",
      "headers": {
        "cache-control": "public, max-age=30, must-revalidate"
      }
    },
    {
      "route": "/campus",
      "redirect": "/colleges",
      "statusCode": 301
    },
    {
      "route": "/campus-placement",
      "redirect": "/colleges",
      "statusCode": 301
    },
    {
      "route": "/campus-placements",
      "redirect": "/colleges",
      "statusCode": 301
    },
    {
      "route": "/companies",
      "redirect": "/recruiters",
      "statusCode": 301
    },
    {
      "route": "/benefits",
      "redirect": "/students",
      "statusCode": 301
    },
    {
      "route": "/job-seekers",
      "redirect": "/jobseekers",
      "statusCode": 301
    },
    {
      "route": "/cotact-us",
      "redirect": "/contact-us",
      "statusCode": 301
    },
    {
      "route": "/upskillig-partners",
      "redirect": "/upskilling-partners",
      "statusCode": 301
    },
    {
      "route": "/government",
      "redirect": "/government-partnership",
      "statusCode": 301
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/images/*",
      "/static/*",
      "/*.{ico,png,json,txt,xml,csv,pdf,html}"
    ]
  },
  "mimeTypes": {
    ".json": "application/json",
    ".xml": "application/xml",
    ".csv": "text/csv"
  }
}
